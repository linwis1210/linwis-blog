---
/**
 * 首页 GitHub Activity。
 * 异步加载公开事件，失败或超时直接隐藏区块，不阻塞页面其他内容。
 * 在 src/config/social.ts 的 FEATURES.githubActivity 中配置。
 */
import { FEATURES } from "../config/social";

const ga = FEATURES.githubActivity;
const dev = import.meta.env.DEV;
const enabled = ga.enabled && Boolean(ga.username);
---

{
  enabled ? (
    <section
      id="github-activity"
      class="mt-16 lg:mt-24"
      data-username={ga.username}
      data-timeout-ms={String(ga.timeoutMs)}
    >
      <h2 class="text-sm font-semibold tracking-tight">GitHub Activity</h2>
      <ul id="github-activity-list" class="mt-3 space-y-2 text-sm" />
    </section>
  ) : dev ? (
    <section class="mt-16 lg:mt-24">
      <h2 class="text-sm font-semibold tracking-tight">GitHub Activity</h2>
      <p class="mt-3 rounded-lg border border-dashed border-line px-4 py-6 text-center text-xs text-faint">
        GitHub Activity 未启用 — 在 src/config/social.ts 的 FEATURES.githubActivity 中设 enabled:
        true（生产环境下此占位不渲染）
      </p>
    </section>
  ) : null
}

<script>
  const section = document.getElementById("github-activity");
  const list = document.getElementById("github-activity-list");

  if (section && list) {
    const username = section.dataset.username;
    const timeoutMs = Number(section.dataset.timeoutMs ?? 6000);

    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);

    fetch(`https://api.github.com/users/${username}/events/public?per_page=5`, {
      signal: controller.signal,
    })
      .then((res) => {
        if (!res.ok) throw new Error(String(res.status));
        return res.json();
      })
      .then((events) => {
        clearTimeout(timer);
        if (!Array.isArray(events) || events.length === 0) {
          section.remove();
          return;
        }
        list.innerHTML = events
          .slice(0, 5)
          .map((e: { type: string; repo: { name: string }; created_at: string }) => {
            const action = e.type.replace("Event", "");
            const date = new Date(e.created_at).toISOString().slice(0, 10);
            return `<li class="flex items-baseline gap-2.5 font-mono text-xs">
              <span class="text-faint tabular-nums">${date}</span>
              <span class="text-muted">${action}</span>
              <span class="text-accent truncate">${e.repo.name}</span>
            </li>`;
          })
          .join("");
      })
      .catch(() => section.remove());
  }
</script>
