<!-- 全局搜索对话框：Ctrl/Cmd+K 或导航栏按钮打开 -->
<dialog id="search-dialog" class="search-dialog" aria-label="站内搜索">
  <div class="flex items-center gap-2 border-b border-line px-4">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-faint shrink-0" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      id="search-input"
      type="search"
      placeholder="搜索文章、项目、标签…"
      autocomplete="off"
      spellcheck="false"
      class="w-full bg-transparent py-3.5 text-sm outline-none placeholder:text-faint"
      aria-label="搜索关键词"
    />
    <kbd>Esc</kbd>
  </div>
  <ul
    id="search-results"
    class="overflow-y-auto overscroll-contain py-1.5"
    role="listbox"
    aria-label="搜索结果"
  ></ul>
</dialog>

<script>
  interface SearchDoc {
    url: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
    kind: "post" | "project";
    body: string;
  }

  const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const list = document.getElementById("search-results");

  let index: SearchDoc[] | null = null;
  let results: SearchDoc[] = [];
  let active = -1;

  async function loadIndex(): Promise<SearchDoc[]> {
    if (index) return index;
    const res = await fetch("/search-index.json");
    if (!res.ok) throw new Error("search index unavailable");
    index = (await res.json()) as SearchDoc[];
    return index;
  }

  /** 简易模糊匹配：所有关键词按序命中（子串/首字母），带位置加分 */
  function score(doc: SearchDoc, query: string): number {
    const q = query.toLowerCase().trim();
    if (!q) return 0;
    const terms = q.split(/\s+/);
    const title = doc.title.toLowerCase();
    const desc = doc.description.toLowerCase();
    const tags = doc.tags.join(" ").toLowerCase();
    const cat = doc.category.toLowerCase();
    const body = doc.body.toLowerCase();

    let total = 0;
    for (const term of terms) {
      let s = 0;
      if (title.includes(term)) s += 100 - title.indexOf(term);
      if (tags.includes(term)) s += 40;
      if (cat.includes(term)) s += 30;
      if (desc.includes(term)) s += 20;
      if (body.includes(term)) s += 10;
      // 关键词全部未命中则淘汰
      if (s === 0) return 0;
      total += s;
    }
    return total;
  }

  function escapeHtml(str: string): string {
    return str.replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[c] as string);
  }

  function highlight(text: string, query: string): string {
    const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let html = escapeHtml(text);
    for (const term of terms) {
      const safe = escapeHtml(term).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      html = html.replace(new RegExp(`(${safe})`, "gi"), "<mark>$1</mark>");
    }
    // 避免嵌套 mark 二次替换出乱码：简单场景够用
    return html;
  }

  function render(query: string): void {
    if (!list) return;
    if (!query.trim()) {
      list.innerHTML = "";
      active = -1;
      return;
    }
    const scored = (index ?? [])
      .map((doc) => ({ doc, s: score(doc, query) }))
      .filter((r) => r.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 12);
    results = scored.map((r) => r.doc);

    if (results.length === 0) {
      list.innerHTML =
        '<li class="px-4 py-6 text-sm text-muted text-center">没有找到相关内容，换个关键词试试。</li>';
      active = -1;
      return;
    }

    list.innerHTML = results
      .map((doc, i) => {
        const meta = doc.kind === "post" ? `文章 · ${doc.category}` : "项目";
        return `
        <li role="option" aria-selected="false" data-index="${i}" class="search-item">
          <a href="${doc.url}" class="block px-4 py-2.5">
            <p class="text-sm font-medium">${highlight(doc.title, query)}</p>
            <p class="mt-0.5 text-xs text-muted line-clamp-1">${meta}${doc.description ? " · " + escapeHtml(doc.description) : ""}</p>
          </a>
        </li>`;
      })
      .join("");
    active = -1;
  }

  function setActive(next: number): void {
    if (!list) return;
    const items = list.querySelectorAll<HTMLElement>(".search-item");
    items.forEach((el) => {
      el.setAttribute("aria-selected", "false");
      el.firstElementChild?.classList.remove("bg-accent-soft");
    });
    active = next;
    if (active < 0 || active >= items.length) return;
    const el = items[active];
    el.setAttribute("aria-selected", "true");
    el.firstElementChild?.classList.add("bg-accent-soft");
    el.scrollIntoView({ block: "nearest" });
  }

  function open(): void {
    if (!dialog) return;
    dialog.showModal();
    loadIndex()
      .then(() => {
        if (input && !input.value.trim()) {
          if (list) list.innerHTML = "";
          return;
        }
        render(input?.value ?? "");
      })
      .catch(() => {
        if (list)
          list.innerHTML =
            '<li class="px-4 py-6 text-sm text-muted text-center">搜索索引加载失败，请检查网络后重试。</li>';
      });
    input?.focus();
    input?.select();
  }

  document.querySelectorAll("[data-search-open]").forEach((btn) => {
    btn.addEventListener("click", open);
  });

  window.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      dialog?.open ? dialog.close() : open();
    }
  });

  input?.addEventListener("input", () => {
    if (!index) {
      if (list)
        list.innerHTML =
          '<li class="px-4 py-6 text-sm text-muted text-center">索引加载中…</li>';
      loadIndex()
        .then(() => render(input.value))
        .catch(() => {
          if (list)
            list.innerHTML =
              '<li class="px-4 py-6 text-sm text-muted text-center">搜索索引加载失败，请检查网络后重试。</li>';
        });
      return;
    }
    render(input.value);
  });

  input?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(Math.min(active + 1, results.length - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(Math.max(active - 1, 0));
    } else if (e.key === "Enter" && active >= 0 && results[active]) {
      e.preventDefault();
      window.location.href = results[active].url;
    }
  });

  // 点击 backdrop 关闭
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  // 选中高亮项
  list?.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest<HTMLElement>(".search-item");
    if (!target) return;
    const doc = results[Number(target.dataset.index)];
    if (doc) window.location.href = doc.url;
  });
</script>
