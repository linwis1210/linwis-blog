---
import "../styles/global.css";
import { SITE } from "../config/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";
import CursorEffects from "../components/CursorEffects.astro";
import Analytics from "../components/Analytics.astro";
import Mermaid from "../components/Mermaid.astro";
import { FEATURES } from "../config/social";

interface Props {
  title?: string;
  description?: string;
  /** og:type，默认 "website"；文章页传 "article" */
  ogType?: string;
  /** article:published_time（ISO 8601，文章页传入时才输出） */
  publishedTime?: string;
  /** article:modified_time（ISO 8601，文章页传入时才输出） */
  modifiedTime?: string;
  /** OG 图片路径（根相对，如 "/og/<slug>.png"）；缺省用全站默认图 /og/default.png */
  ogImage?: string;
  /** 附加结构化数据（JSON-LD 对象数组，与全站 WebSite JSON-LD 一起注入 head） */
  jsonLd?: object[];
}

const {
  title,
  description = SITE.description,
  ogType = "website",
  publishedTime,
  modifiedTime,
  ogImage,
  jsonLd = [],
} = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage ?? "/og/default.png", Astro.site).toString();

/** JSON-LD 安全序列化：转义 "<" 防止内容中出现 "</script>" 提前闭合标签 */
function toJsonLd(data: object): string {
  return JSON.stringify(data).replace(/</g, "\\u003c");
}

const websiteJsonLd = toJsonLd({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  url: SITE.url,
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- giscus 预连接：提前与评论脚本/样式源建立 TLS，降低评论区与样式注入延迟。
         条件与 Giscus.astro 渲染条件同源（FEATURES.giscus）。 -->
    {
      FEATURES.giscus.enabled && FEATURES.giscus.repo && FEATURES.giscus.repoId && (
        <link rel="preconnect" href="https://giscus.app" crossorigin />
      )
    }
    <!-- 主题防闪烁：首帧渲染前根据 localStorage / 系统偏好设置 class -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {
      SITE.googleSiteVerification && (
        <meta name="google-site-verification" content={SITE.googleSiteVerification} />
      )
    }
    {SITE.bingSiteVerification && <meta name="msvalidate.01" content={SITE.bingSiteVerification} />}
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={websiteJsonLd} is:inline />
    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={toJsonLd(data)} is:inline />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:px-3 focus:py-2 focus:rounded-md focus:border focus:border-line"
    >
      跳到主要内容
    </a>
    <Header />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <CursorEffects />
    <Analytics />
    <Mermaid />

    <!-- 图片 Lightbox -->
    <dialog id="lightbox" class="lightbox-dialog" aria-label="图片预览">
      <img src="" alt="" />
    </dialog>

    <script>
      // 阅读进度条：仅在包含 article 的页面计算滚动比例
      const progressBar = document.getElementById("reading-progress");
      const articleEl = document.querySelector("article");
      if (progressBar && articleEl) {
        let ticking = false;
        const updateProgress = () => {
          const rect = articleEl.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          if (total <= 0) {
            progressBar.style.width = "0%";
            ticking = false;
            return;
          }
          const current = Math.max(0, -rect.top);
          const percent = Math.min(100, Math.round((current / total) * 100));
          progressBar.style.width = `${percent}%`;
          ticking = false;
        };

        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              window.requestAnimationFrame(updateProgress);
              ticking = true;
            }
          },
          { passive: true }
        );
        updateProgress();
      }

      // 代码块增强：GitHub 风格轻量顶栏（语言/文件名 + 复制按钮）
      document.querySelectorAll<HTMLElement>(".prose .astro-code").forEach((pre) => {
        if (pre.parentElement?.classList.contains("code-block-wrapper")) return;

        const rawLang = pre.getAttribute("data-language") || "";
        const lang = rawLang.toLowerCase();

        // mermaid 由 Mermaid 组件专门接管渲染与交互，避免生成两层顶栏
        if (lang === "mermaid") return;

        const wrapper = document.createElement("div");
        wrapper.className = "code-block-wrapper";

        const header = document.createElement("div");
        header.className = "code-header";

        const langTag = document.createElement("span");
        langTag.className =
          "font-mono uppercase tracking-wider text-[10px] text-faint font-semibold";
        langTag.textContent = lang || "CODE";
        header.appendChild(langTag);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "code-copy-btn inline-flex items-center gap-1.5 rounded px-2 py-0.5 text-[11px] text-muted hover:text-fg hover:bg-surface transition-colors";
        btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><span>Copy</span>`;

        btn.addEventListener("click", async () => {
          const code = pre.querySelector("code")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(code);
            btn.innerHTML = `<span>Copied</span>`;
            btn.classList.add("text-accent");
          } catch {
            btn.innerHTML = `<span>Failed</span>`;
          }
          setTimeout(() => {
            btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><span>Copy</span>`;
            btn.classList.remove("text-accent");
          }, 1600);
        });

        header.appendChild(btn);

        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(header);
        wrapper.appendChild(pre);
      });

      // 图片 Lightbox：点击正文图片放大预览
      const lightbox = document.getElementById("lightbox") as HTMLDialogElement | null;
      const lightboxImg = lightbox?.querySelector("img");
      document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
        img.loading = "lazy";
        img.style.cursor = "zoom-in";
        img.addEventListener("click", () => {
          if (!lightbox || !lightboxImg) return;
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt;
          lightbox.showModal();
        });
      });
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox || e.target === lightboxImg) lightbox.close();
      });

      // 标题锚点：点击时复制带 hash 的完整链接（同时保留默认跳转）
      document.querySelectorAll<HTMLAnchorElement>(".heading-anchor").forEach((a) => {
        a.addEventListener("click", () => {
          const id = a.closest<HTMLElement>("[id]")?.id;
          if (!id) return;
          navigator.clipboard
            .writeText(`${window.location.origin}${window.location.pathname}#${id}`)
            .catch(() => {});
        });
      });
    </script>
  </body>
</html>
