---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../lib/posts";

const posts = getPublishedPosts(await getCollection("blog")).slice(0, 5);
---

<BaseLayout title="404" description="页面不存在。">
  <div class="page-shell pt-16 sm:pt-24 pb-16">
    <p class="display-lg font-mono" aria-hidden="true">
      4<span class="text-accent">0</span>4
    </p>
    <h1 class="mt-5 text-xl font-bold tracking-tight">这个页面不存在</h1>
    <p class="lead mt-3">
      可能是链接写错了，或者文章还在草稿箱里。按
      <kbd>Ctrl</kbd>
      <kbd>K</kbd> 搜一搜，或者从下面的入口继续。
    </p>

    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a
        href="/"
        class="inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-hover transition-colors"
      >
        回到首页
      </a>
      <a
        href="/blog"
        class="inline-flex items-center rounded-lg border border-line-strong px-4 py-2 text-sm text-fg hover:border-fg transition-colors"
      >
        浏览博客
      </a>
      <button
        type="button"
        data-search-open
        class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm text-muted hover:text-fg transition-colors"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        搜索文章
      </button>
    </div>

    {
      posts.length > 0 && (
        <section class="mt-16 pt-8 border-t border-line" aria-label="最新文章">
          <h2 class="text-sm font-semibold tracking-tight">最新文章</h2>
          <div class="mt-3">
            <PostList posts={posts} />
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
