---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL } from "../config/social";

const stackGroups = [
  { name: "语言", items: ["TypeScript", "Python", "C", "SQL"] },
  { name: "前端", items: ["Astro", "Tailwind CSS", "React", "Vite"] },
  { name: "服务端", items: ["Node.js", "Nginx", "Docker", "Linux"] },
  { name: "工程化", items: ["Git", "GitHub Actions", "Cloudflare", "Playwright"] },
];
---

<BaseLayout title="About" description="关于 linwis_：开发者、持续学习者，以及这个博客的由来。">
  <div class="page-shell pt-12 sm:pt-16 pb-16 lg:pb-24">
    <h1 class="display-lg">About</h1>

    <div class="mt-10 grid sm:grid-cols-[auto_1fr] gap-6 sm:gap-8 items-start">
      <!-- 头像占位：v1.0 首页不使用真人头像，About 页可替换为真实头像 -->
      <div
        class="size-24 rounded-xl border border-line bg-surface flex items-center justify-center font-mono text-2xl font-bold select-none"
        aria-hidden="true"
      >
        <span>L<span class="text-accent">_</span></span>
      </div>

      <div class="prose max-w-none">
        <p>
          我是 <strong>linwis_</strong>，开发者，也是持续学习者。白天写业务代码，
          晚上折腾自己的项目；相信把学到的东西写下来，才算真正学会。
        </p>
        <p>
          这个博客是我的第二大脑：部署、前端、工程化的实践笔记，
          以及每个项目做完之后的技术复盘。文章都在
          <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          上公开，发现问题欢迎 Issue 或 PR。
        </p>
      </div>
    </div>

    <section class="mt-12" aria-label="技术栈">
      <h2 class="text-sm font-semibold tracking-tight">技术栈</h2>
      <div class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-5">
        {
          stackGroups.map((group) => (
            <div>
              <h3 class="font-mono text-[11px] text-faint">{group.name}</h3>
              <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
                {group.items.map((item) => (
                  <li class="text-muted">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12 max-w-2xl" aria-label="写博客的原因">
      <h2 class="text-sm font-semibold tracking-tight">为什么写博客</h2>
      <div class="prose mt-4">
        <p>
          输出是最贵的输入。一个问题查了三天的资料，写成文章只要两小时；
          而下次再遇到，只需要搜索自己的博客。
        </p>
        <p>
          我也希望通过公开写作强迫自己把话说清楚——能给别人讲明白，
          才是真的理解了。
        </p>
      </div>
    </section>

    <section class="mt-12 max-w-2xl" aria-label="联系方式">
      <h2 class="text-sm font-semibold tracking-tight">联系我</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <span class="text-muted inline-block w-16">GitHub</span>
          <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline underline-offset-4">
            @{SOCIAL.github.split("/").pop()}
          </a>
        </li>
        <li>
          <span class="text-muted inline-block w-16">Email</span>
          <a href={`mailto:${SOCIAL.email}`} class="text-accent hover:underline underline-offset-4">
            {SOCIAL.email}
          </a>
        </li>
        {
          SOCIAL.links.map((link) => (
            <li>
              <span class="text-muted inline-block w-16">{link.label}</span>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline underline-offset-4">
                {link.url}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs text-faint">不提供留言表单，邮件最直接。</p>
    </section>
  </div>
</BaseLayout>
