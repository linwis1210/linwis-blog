---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import { getPublishedPosts } from "../lib/posts";
import { SOCIAL } from "../config/social";
import { SITE } from "../config/site";

const allPosts = await getCollection("blog");
const posts = getPublishedPosts(allPosts).slice(0, 5);

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (b.data.startedAt?.getTime() ?? 0) - (a.data.startedAt?.getTime() ?? 0));
---

<BaseLayout>
  <div class="page-shell pt-16 sm:pt-24 pb-20 lg:pb-28">
    <!-- Hero：display-xl 身份 + 简介句，无装饰组件（DESIGN.md §30） -->
    <section>
      <p class="display-xl font-mono" aria-label="linwis">
        linwis_<span class="caret" aria-hidden="true"></span>
      </p>
      <h1 class="mt-6 sm:mt-8 text-xl sm:text-2xl font-bold tracking-tight">
        {SITE.tagline}
      </h1>
      <p class="lead mt-3">保持思考，保持学习。</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/blog"
          class="inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-hover transition-colors"
        >
          阅读博客
        </a>
        <a
          href="/projects"
          class="inline-flex items-center rounded-lg border border-line-strong px-4 py-2 text-sm text-fg hover:border-fg transition-colors"
        >
          浏览项目
        </a>
        <a
          href={SOCIAL.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm text-muted hover:text-fg transition-colors"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path>
          </svg>
          GitHub
        </a>
      </div>
    </section>

    <!-- 精选项目 -->
    {
      featuredProjects.length > 0 && (
        <section class="mt-20 lg:mt-28" aria-label="精选项目">
          <div class="flex items-baseline justify-between">
            <h2 class="text-sm font-semibold tracking-tight">精选项目</h2>
            <a href="/projects" class="text-xs text-muted hover:text-fg transition-colors">
              全部项目
            </a>
          </div>
          <div class="mt-5 grid sm:grid-cols-2 gap-4">
            {featuredProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      )
    }

    <!-- 最新文章 -->
    <section class="mt-16 lg:mt-24" aria-label="最新文章">
      <div class="flex items-baseline justify-between">
        <h2 class="text-sm font-semibold tracking-tight">最新文章</h2>
        <a href="/blog" class="text-xs text-muted hover:text-fg transition-colors">
          全部文章
        </a>
      </div>
      <div class="mt-3">
        <PostList posts={posts} numbered showCategory />
      </div>
    </section>

    <GitHubActivity />
  </div>
</BaseLayout>
