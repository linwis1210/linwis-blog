---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const { title, description, status, techStack, github, demo, cover, screenshots, startedAt } =
  project.data;

const STATUS_LABEL = {
  active: "Active",
  completed: "Completed",
  archived: "Archived",
} as const;

const STATUS_DOT = {
  active: "bg-success",
  completed: "bg-accent",
  archived: "bg-faint",
} as const;

// 相关文章聚合：由文章 frontmatter 的 project 字段声明归属
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter((p) => !p.data.draft && p.data.project === project.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={title} description={description}>
  <div class="page-shell pt-12 sm:pt-16 pb-16 lg:pb-24">
    <a href="/projects" class="font-mono text-xs text-faint hover:text-accent transition-colors">
      ← /projects
    </a>

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <h1 class="display-lg max-w-[24ch]">{title}</h1>
        <span class="flex items-center gap-1.5 font-mono text-[11px] text-muted">
          <span
            class={`inline-block size-1.5 rounded-full ${STATUS_DOT[status]}`}
            aria-hidden="true"></span>
          {STATUS_LABEL[status]}
        </span>
      </div>
      <p class="lead mt-4">{description}</p>
    </header>

    {
      techStack.length > 0 && (
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[11px] text-faint">
          {techStack.map((t) => (
            <span>{t}</span>
          ))}
        </div>
      )
    }

    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs">
      {startedAt && <span class="font-mono text-faint">开始于 {formatDate(startedAt)}</span>}
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-accent transition-colors inline-flex items-center gap-1"
          >
            GitHub
            <svg
              width="10"
              height="10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
        )
      }
      {
        demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-accent transition-colors inline-flex items-center gap-1"
          >
            Demo
            <svg
              width="10"
              height="10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
        )
      }
    </div>

    {
      cover && (
        <figure class="mt-10">
          <img
            src={cover}
            alt={`${title} 封面`}
            width="1200"
            height="630"
            class="w-full rounded-xl border border-line"
            loading="eager"
          />
        </figure>
      )
    }

    {
      screenshots.length > 1 && (
        <section class="mt-6" aria-label="截图">
          <div class="grid sm:grid-cols-2 gap-4">
            {screenshots.map((src, i) => (
              <img
                src={src}
                alt={`${title} 截图 ${i + 1}`}
                width="1200"
                height="630"
                class="w-full rounded-xl border border-line cursor-zoom-in"
                loading="lazy"
                data-lightbox
              />
            ))}
          </div>
        </section>
      )
    }

    <div class="prose mt-12">
      <Content />
    </div>

    <!-- 相关文章（自动聚合） -->
    {
      relatedPosts.length > 0 && (
        <section class="mt-14 pt-6 border-t border-line" aria-label="相关文章">
          <h2 class="text-sm font-semibold tracking-tight">相关文章</h2>
          <ul class="mt-4 divide-y divide-line">
            {relatedPosts.map((p) => (
              <li>
                <a href={`/blog/${p.id}`} class="group flex items-baseline gap-4 py-3">
                  <time class="font-mono text-xs text-faint tabular-nums shrink-0 w-[88px]">
                    {formatDate(p.data.date)}
                  </time>
                  <span class="text-[15px] font-medium group-hover:text-accent transition-colors min-w-0 truncate">
                    {p.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  // 项目截图 Lightbox（复用全局 #lightbox 对话框）
  const lightbox = document.getElementById("lightbox") as HTMLDialogElement | null;
  const lightboxImg = lightbox?.querySelector("img");
  document.querySelectorAll<HTMLElement>("[data-lightbox]").forEach((img) => {
    img.addEventListener("click", () => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.setAttribute("src", (img as HTMLImageElement).src);
      lightboxImg.setAttribute("alt", (img as HTMLImageElement).alt);
      lightbox.showModal();
    });
  });
</script>
